4, 27257, 4706, 11, 50653], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 869, "seek": 306304, "start": 3069.0, "end": 3069.2599999999998, "text": " delta.", "tokens": [50663, 8289, 13, 50676], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 870, "seek": 306304, "start": 3069.86, "end": 3071.62, "text": " You created massive technical debt.", "tokens": [50706, 509, 2942, 5994, 6191, 7831, 13, 50794], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 871, "seek": 306304, "start": 3072.32, "end": 3072.74, "text": " Precisely.", "tokens": [50829, 48746, 736, 13, 50850], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 872, "seek": 306304, "start": 3073.4, "end": 3075.14, "text": " The modification looked like an improvement", "tokens": [50883, 440, 26747, 2956, 411, 364, 10444, 50970], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 873, "seek": 306304, "start": 3075.14, "end": 3077.6, "text": " if you only measured the immediate test suite,", "tokens": [50970, 498, 291, 787, 12690, 264, 11629, 1500, 14205, 11, 51093], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 874, "seek": 306304, "start": 3077.74, "end": 3079.32, "text": " but it was actually a disruption", "tokens": [51100, 457, 309, 390, 767, 257, 28751, 51179], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 875, "seek": 306304, "start": 3079.32, "end": 3081.02, "text": " dressed as an improvement.", "tokens": [51179, 12386, 382, 364, 10444, 13, 51264], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 876, "seek": 306304, "start": 3081.2599999999998, "end": 3082.96, "text": " A disruption dressed as an improvement.", "tokens": [51276, 316, 28751, 12386, 382, 364, 10444, 13, 51361], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 877, "seek": 306304, "start": 3083.2799999999997, "end": 3083.62, "text": " Wow.", "tokens": [51377, 3153, 13, 51394], "temperature": 0.0, "avg_logprob": -0.2843117347130409, "compression_ratio": 1.6820276497695852, "no_speech_prob": 2.475472734783657e-12}, {"id": 878, "seek": 308362, "start": 3083.62, "end": 3085.46, "text": " The effective space of genuine,", "tokens": [50365, 440, 4942, 1901, 295, 16699, 11, 50457], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 879, "seek": 308362, "start": 3085.7999999999997, "end": 3087.98, "text": " sustainable repair in legacy software", "tokens": [50474, 11235, 10535, 294, 11711, 4722, 50583], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 880, "seek": 308362, "start": 3087.98, "end": 3089.7799999999997, "text": " is infinitely smaller", "tokens": [50583, 307, 36227, 4356, 50673], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 881, "seek": 308362, "start": 3089.7799999999997, "end": 3090.8199999999997, "text": " than the formal space", "tokens": [50673, 813, 264, 9860, 1901, 50725], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 882, "seek": 308362, "start": 3090.8199999999997, "end": 3092.5, "text": " of all possible code changes", "tokens": [50725, 295, 439, 1944, 3089, 2962, 50809], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 883, "seek": 308362, "start": 3092.5, "end": 3094.66, "text": " you could theoretically type into the editor.", "tokens": [50809, 291, 727, 29400, 2010, 666, 264, 9839, 13, 50917], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 884, "seek": 308362, "start": 3095.2, "end": 3096.7799999999997, "text": " Most changes that add a feature", "tokens": [50944, 4534, 2962, 300, 909, 257, 4111, 51023], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 885, "seek": 308362, "start": 3096.7799999999997, "end": 3097.94, "text": " will break the architecture.", "tokens": [51023, 486, 1821, 264, 9482, 13, 51081], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 886, "seek": 308362, "start": 3098.72, "end": 3100.52, "text": " Finding the rare change that does both", "tokens": [51120, 31947, 264, 5892, 1319, 300, 775, 1293, 51210], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 887, "seek": 308362, "start": 3100.52, "end": 3101.72, "text": " is the real work.", "tokens": [51210, 307, 264, 957, 589, 13, 51270], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 888, "seek": 308362, "start": 3101.88, "end": 3103.2599999999998, "text": " And the paper also connects this", "tokens": [51278, 400, 264, 3035, 611, 16967, 341, 51347], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 889, "seek": 308362, "start": 3103.2599999999998, "end": 3104.44, "text": " to evolutionary biology,", "tokens": [51347, 281, 27567, 14956, 11, 51406], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 890, "seek": 308362, "start": 3104.98, "end": 3106.74, "text": " which I found totally fascinating.", "tokens": [51433, 597, 286, 1352, 3879, 10343, 13, 51521], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 891, "seek": 308362, "start": 3106.8399999999997, "end": 3107.94, "text": " It's a very apt comparison.", "tokens": [51526, 467, 311, 257, 588, 29427, 9660, 13, 51581], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 892, "seek": 308362, "start": 3108.3399999999997, "end": 3109.48, "text": " Think about genetic mutation.", "tokens": [51601, 6557, 466, 12462, 27960, 13, 51658], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 893, "seek": 308362, "start": 3110.0, "end": 3111.18, "text": " The DNA of an organism", "tokens": [51684, 440, 8272, 295, 364, 24128, 51743], "temperature": 0.0, "avg_logprob": -0.17213807224242156, "compression_ratio": 1.610738255033557, "no_speech_prob": 2.3119186686598736e-12}, {"id": 894, "seek": 311118, "start": 3111.18, "end": 3113.04, "text": " contains millions of base pairs.", "tokens": [50365, 8306, 6803, 295, 3096, 15494, 13, 50458], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 895, "seek": 311118, "start": 3113.18, "end": 3113.3599999999997, "text": " Right.", "tokens": [50465, 1779, 13, 50474], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 896, "seek": 311118, "start": 3113.56, "end": 3115.64, "text": " The nominal freedom for mutation is vast.", "tokens": [50484, 440, 41641, 5645, 337, 27960, 307, 8369, 13, 50588], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 897, "seek": 311118, "start": 3116.18, "end": 3117.68, "text": " There are nearly endless combinations.", "tokens": [50615, 821, 366, 6217, 16144, 21267, 13, 50690], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 898, "seek": 311118, "start": 3118.12, "end": 3119.08, "text": " But most of those", "tokens": [50712, 583, 881, 295, 729, 50760], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 899, "seek": 311118, "start": 3119.08, "end": 3120.68, "text": " theoretically available mutations", "tokens": [50760, 29400, 2435, 29243, 50840], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 900, "seek": 311118, "start": 3120.68, "end": 3122.14, "text": " are simply not viable.", "tokens": [50840, 366, 2935, 406, 22024, 13, 50913], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 901, "seek": 311118, "start": 3122.46, "end": 3123.66, "text": " Because they break things.", "tokens": [50929, 1436, 436, 1821, 721, 13, 50989], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 902, "seek": 311118, "start": 3123.7599999999998, "end": 3123.96, "text": " Right.", "tokens": [50994, 1779, 13, 51004], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 903, "seek": 311118, "start": 3124.22, "end": 3125.6, "text": " Regardless of whether the mutation", "tokens": [51017, 25148, 295, 1968, 264, 27960, 51086], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 904, "seek": 311118, "start": 3125.6, "end": 3127.24, "text": " is a massive structural change", "tokens": [51086, 307, 257, 5994, 15067, 1319, 51168], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 905, "seek": 311118, "start": 3127.24, "end": 3128.7, "text": " or a tiny point mutation,", "tokens": [51168, 420, 257, 5870, 935, 27960, 11, 51241], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 906, "seek": 311118, "start": 3129.54, "end": 3131.98, "text": " if it unravels the existing functioning organism,", "tokens": [51283, 498, 309, 40507, 82, 264, 6741, 18483, 24128, 11, 51405], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 907, "seek": 311118, "start": 3132.44, "end": 3134.02, "text": " if it breaks the heart or the lungs,", "tokens": [51428, 498, 309, 9857, 264, 1917, 420, 264, 19467, 11, 51507], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 908, "seek": 311118, "start": 3134.54, "end": 3135.4199999999996, "text": " it will not survive.", "tokens": [51533, 309, 486, 406, 7867, 13, 51577], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 909, "seek": 311118, "start": 3135.8399999999997, "end": 3137.48, "text": " Restoring or adapting function", "tokens": [51598, 13094, 3662, 420, 34942, 2445, 51680], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 910, "seek": 311118, "start": 3137.48, "end": 3138.44, "text": " in a living thing", "tokens": [51680, 294, 257, 2647, 551, 51728], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 911, "seek": 311118, "start": 3138.44, "end": 3139.74, "text": " is fundamentally different", "tokens": [51728, 307, 17879, 819, 51793], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 912, "seek": 311118, "start": 3139.74, "end": 3140.8399999999997, "text": " from constructing function", "tokens": [51793, 490, 39969, 2445, 51848], "temperature": 0.0, "avg_logprob": -0.21443673593026621, "compression_ratio": 1.7972972972972974, "no_speech_prob": 2.371562798572646e-12}, {"id": 913, "seek": 314084, "start": 3140.84, "end": 3141.54, "text": " from scratch.", "tokens": [50365, 490, 8459, 13, 50400], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 914, "seek": 314084, "start": 3142.1000000000004, "end": 3143.2400000000002, "text": " Evolution has to find", "tokens": [50428, 40800, 575, 281, 915, 50485], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 915, "seek": 314084, "start": 3143.2400000000002, "end": 3144.2400000000002, "text": " the repair sets", "tokens": [50485, 264, 10535, 6352, 50535], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 916, "seek": 314084, "start": 3144.2400000000002, "end": 3145.7400000000002, "text": " in the genetic code.", "tokens": [50535, 294, 264, 12462, 3089, 13, 50610], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 917, "seek": 314084, "start": 3145.96, "end": 3146.44, "text": " Exactly.", "tokens": [50621, 7587, 13, 50645], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 918, "seek": 314084, "start": 3146.8, "end": 3147.7000000000003, "text": " It has to find the places", "tokens": [50663, 467, 575, 281, 915, 264, 3190, 50708], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 919, "seek": 314084, "start": 3147.7000000000003, "end": 3149.38, "text": " where plasticity is high enough", "tokens": [50708, 689, 5900, 507, 307, 1090, 1547, 50792], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 920, "seek": 314084, "start": 3149.38, "end": 3151.32, "text": " to allow a new trait to emerge,", "tokens": [50792, 281, 2089, 257, 777, 22538, 281, 21511, 11, 50889], "temperature": 0.0, "avg_logprob": -0.18318074847024585, "compression_ratio": 1.6514084507042253, "no_speech_prob": 1.8906330494228296e-12}, {"id": 921, "seek": 314084, "start": 3151.5, "end": 3153.32, "text": " but abstraction is stable enough", "tokens": [50898, 457, 37765, 307, 8351, 1547, 50989], "temper