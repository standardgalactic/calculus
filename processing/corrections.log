999999997, "end": 3005.1, "text": " we talked about at the very beginning.", "tokens": [50993, 321, 2825, 466, 412, 264, 588, 2863, 13, 51059], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 830, "seek": 299122, "start": 3005.2999999999997, "end": 3005.72, "text": " It does.", "tokens": [51069, 467, 775, 13, 51090], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 831, "seek": 299122, "start": 3005.8399999999997, "end": 3007.7799999999997, "text": " Just because a system has millions", "tokens": [51096, 1449, 570, 257, 1185, 575, 6803, 51193], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 832, "seek": 299122, "start": 3007.7799999999997, "end": 3009.2999999999997, "text": " of nominally free parameters", "tokens": [51193, 295, 5369, 19801, 1737, 9834, 51269], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 833, "seek": 299122, "start": 3009.2999999999997, "end": 3011.1, "text": " or to take it out of AI,", "tokens": [51269, 420, 281, 747, 309, 484, 295, 7318, 11, 51359], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 834, "seek": 299122, "start": 3011.48, "end": 3013.08, "text": " just because you have countless options", "tokens": [51378, 445, 570, 291, 362, 19223, 3956, 51458], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 835, "seek": 299122, "start": 3013.08, "end": 3014.7599999999998, "text": " in your life, your career,", "tokens": [51458, 294, 428, 993, 11, 428, 3988, 11, 51542], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 836, "seek": 299122, "start": 3014.8599999999997, "end": 3016.3199999999997, "text": " or your business organization", "tokens": [51547, 420, 428, 1606, 4475, 51620], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 837, "seek": 299122, "start": 3016.3199999999997, "end": 3018.64, "text": " doesn't mean you have the effective freedom", "tokens": [51620, 1177, 380, 914, 291, 362, 264, 4942, 5645, 51736], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 838, "seek": 299122, "start": 3018.64, "end": 3020.56, "text": " to improve using all of them.", "tokens": [51736, 281, 3470, 1228, 439, 295, 552, 13, 51832], "temperature": 0.0, "avg_logprob": -0.16228390502929688, "compression_ratio": 1.7118055555555556, "no_speech_prob": 1.649207463302882e-12}, {"id": 839, "seek": 302056, "start": 3020.56, "end": 3022.42, "text": " If we connect this to the bigger picture,", "tokens": [50365, 759, 321, 1745, 341, 281, 264, 3801, 3036, 11, 50458], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 840, "seek": 302056, "start": 3022.94, "end": 3024.64, "text": " the paper draws explicit connections", "tokens": [50484, 264, 3035, 20045, 13691, 9271, 50569], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 841, "seek": 302056, "start": 3024.64, "end": 3025.58, "text": " to other fields", "tokens": [50569, 281, 661, 7909, 50616], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 842, "seek": 302056, "start": 3025.58, "end": 3027.82, "text": " where a system's prior organization", "tokens": [50616, 689, 257, 1185, 311, 4059, 4475, 50728], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 843, "seek": 302056, "start": 3027.82, "end": 3029.44, "text": " has massive value", "tokens": [50728, 575, 5994, 2158, 50809], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 844, "seek": 302056, "start": 3029.44, "end": 3031.7599999999998, "text": " independent of whatever new objective", "tokens": [50809, 6695, 295, 2035, 777, 10024, 50925], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 845, "seek": 302056, "start": 3031.7599999999998, "end": 3033.2599999999998, "text": " you are currently trying to optimize.", "tokens": [50925, 291, 366, 4362, 1382, 281, 19719, 13, 51000], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 846, "seek": 302056, "start": 3033.48, "end": 3034.54, "text": " Like software engineering,", "tokens": [51011, 1743, 4722, 7043, 11, 51064], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 847, "seek": 302056, "start": 3035.22, "end": 3036.7799999999997, "text": " the paper mentions software maintenance.", "tokens": [51098, 264, 3035, 23844, 4722, 11258, 13, 51176], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 848, "seek": 302056, "start": 3037.56, "end": 3038.96, "text": " I think anyone who has ever worked", "tokens": [51215, 286, 519, 2878, 567, 575, 1562, 2732, 51285], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 849, "seek": 302056, "start": 3038.96, "end": 3040.66, "text": " with a massive legacy code base", "tokens": [51285, 365, 257, 5994, 11711, 3089, 3096, 51370], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 850, "seek": 302056, "start": 3040.66, "end": 3042.48, "text": " will immediately understand this", "tokens": [51370, 486, 4258, 1223, 341, 51461], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 851, "seek": 302056, "start": 3042.48, "end": 3043.12, "text": " in their bones.", "tokens": [51461, 294, 641, 10491, 13, 51493], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 852, "seek": 302056, "start": 3043.2999999999997, "end": 3043.6, "text": " Definitely.", "tokens": [51502, 12151, 13, 51517], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 853, "seek": 302056, "start": 3044.2, "end": 3045.0, "text": " In software maintenance,", "tokens": [51547, 682, 4722, 11258, 11, 51587], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 854, "seek": 302056, "start": 3045.12, "end": 3045.9, "text": " you might be tasked", "tokens": [51593, 291, 1062, 312, 38621, 51632], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 855, "seek": 302056, "start": 3045.9, "end": 3046.92, "text": " with adding a new feature.", "tokens": [51632, 365, 5127, 257, 777, 4111, 13, 51683], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 856, "seek": 302056, "start": 3047.2999999999997, "end": 3047.94, "text": " You write the code,", "tokens": [51702, 509, 2464, 264, 3089, 11, 51734], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 857, "seek": 302056, "start": 3048.2999999999997, "end": 3049.02, "text": " you patch it in,", "tokens": [51752, 291, 9972, 309, 294, 11, 51788], "temperature": 0.0, "avg_logprob": -0.17236061096191407, "compression_ratio": 1.7119741100323624, "no_speech_prob": 1.655501148493943e-12}, {"id": 858, "seek": 304902, "start": 3049.02, "end": 3050.82, "text": " and it passes the immediate test suite.", "tokens": [50365, 293, 309, 11335, 264, 11629, 1500, 14205, 13, 50455], "temperature": 0.0, "avg_logprob": -0.25779362001280853, "compression_ratio": 1.3908045977011494, "no_speech_prob": 1.4550748843669692e-12}, {"id": 859, "seek": 304902, "start": 3051.4, "end": 3053.08, "text": " You optimize for the current objective.", "tokens": [50484, 509, 19719, 337, 264, 2190, 10024, 13, 50568], "temperature": 0.0, "avg_logprob": -0.25779362001280853, "compression_ratio": 1.3908045977011494, "no_speech_prob": 1.4550748843669692e-12}, {"id": 860, "seek": 304902, "start": 3053.44, "end": 3054.3, "text": " Epsilon is achieved.", "tokens": [50586, 462, 16592, 307, 11042, 13, 50629], "temperature": 0.0, "avg_logprob": -0.25779362001280853, "compression_ratio": 1.3908045977011494, "no_speech_prob": 1.4550748843669692e-12}, {"id": 861, "seek": 304902, "start": 3054.48, "end": 3055.48, "text": " The feature works.", "tokens": [50638, 440, 4111, 1985, 13, 50688], "temperature": 0.0, "avg_logprob": -0.25779362001280853, "compression_ratio": 1.3908045977011494, "no_speech_prob": 1.4550748843669692