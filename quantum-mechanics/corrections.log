, "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 635, "seek": 214562, "start": 2148.88, "end": 2150.3599999999997, "text": " This creates a redundancy,", "tokens": [50528, 639, 7829, 257, 27830, 6717, 11, 50602], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 636, "seek": 214562, "start": 2150.62, "end": 2151.8199999999997, "text": " an artificial rigidity.", "tokens": [50615, 364, 11677, 8329, 17711, 13, 50675], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 637, "seek": 214562, "start": 2152.22, "end": 2154.14, "text": " And if we fix that redundancy...", "tokens": [50695, 400, 498, 321, 3191, 300, 27830, 6717, 485, 50791], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 638, "seek": 214562, "start": 2154.14, "end": 2154.96, "text": " If you quotient out", "tokens": [50791, 759, 291, 9641, 1196, 484, 50832], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 639, "seek": 214562, "start": 2154.96, "end": 2156.2799999999997, "text": " that gauge redundancy,", "tokens": [50832, 300, 17924, 27830, 6717, 11, 50898], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 640, "seek": 214562, "start": 2156.48, "end": 2158.0, "text": " which is a fancy mathematical way", "tokens": [50908, 597, 307, 257, 10247, 18894, 636, 50984], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 641, "seek": 214562, "start": 2158.0, "end": 2159.8599999999997, "text": " of saying you redistribute the phase", "tokens": [50984, 295, 1566, 291, 36198, 2024, 1169, 264, 5574, 51077], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 642, "seek": 214562, "start": 2159.8599999999997, "end": 2161.18, "text": " across the whole tensor product", "tokens": [51077, 2108, 264, 1379, 40863, 1674, 51143], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 643, "seek": 214562, "start": 2161.18, "end": 2162.2799999999997, "text": " so it doesn't matter who holds it,", "tokens": [51143, 370, 309, 1177, 380, 1871, 567, 9190, 309, 11, 51198], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 644, "seek": 214562, "start": 2162.7, "end": 2163.68, "text": " the ambiguity changes.", "tokens": [51219, 264, 46519, 2962, 13, 51268], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 645, "seek": 214562, "start": 2164.52, "end": 2166.3199999999997, "text": " The obstruction we found earlier", "tokens": [51310, 440, 49711, 321, 1352, 3071, 51400], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 646, "seek": 214562, "start": 2166.3199999999997, "end": 2167.2799999999997, "text": " wasn't in the physics", "tokens": [51400, 2067, 380, 294, 264, 10649, 51448], "temperature": 0.0, "avg_logprob": -0.20331177344689003, "compression_ratio": 1.6612903225806452, "no_speech_prob": 2.1425530620511335e-12}, {"id": 647, "seek": 214562, "start": 2167.2799999999997, "end": 2167.8599999999997, "text": " of the universe,", "tokens": [5144