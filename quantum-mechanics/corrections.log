34220, "start": 2355.5, "end": 2356.18, "text": " Under independent", "tokens": [51030, 6974, 6695, 51064], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 806, "seek": 234220, "start": 2356.18, "end": 2357.6, "text": " continuous edge measures,", "tokens": [51064, 10957, 4691, 8000, 11, 51135], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 807, "seek": 234220, "start": 2357.7799999999997, "end": 2359.52, "text": " meaning if you randomly assign", "tokens": [51144, 3620, 498, 291, 16979, 6269, 51231], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 808, "seek": 234220, "start": 2359.52, "end": 2360.4399999999996, "text": " valid probabilities", "tokens": [51231, 7363, 33783, 51277], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 809, "seek": 234220, "start": 2360.4399999999996, "end": 2361.2599999999998, "text": " to the connections,", "tokens": [51277, 281, 264, 9271, 11, 51318], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 810, "seek": 234220, "start": 2361.7799999999997, "end": 2363.56, "text": " the very moment a graph", "tokens": [51344, 264, 588, 1623, 257, 4295, 51433], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 811, "seek": 234220, "start": 2363.56, "end": 2365.5, "text": " has even one single cycle.", "tokens": [51433, 575, 754, 472, 2167, 6586, 13, 51530], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 812, "seek": 234220, "start": 2365.6, "end": 2366.4399999999996, "text": " The moment it loops.", "tokens": [51535, 440, 1623, 309, 16121, 13, 51577], "temperature": 0.0, "avg_logprob": -0.18233116741838126, "compression_ratio": 1.7125984251968505, "no_speech_prob": 3.64177004524846e-12}, {"id": 813, "seek": 236644, "start": 2366.44, "end": 2368.3, "text": " The moment beta 1", "tokens": [50365, 440, 1623, 9861, 502, 50458], "temperature": 0.0, "avg_logprob": -0.17691219016297222, "compression_ratio": 1.6418918918918919, "no_speech_prob": 2.1091346984886128e-12}, {"id": 814, "seek": 236644, "start": 2368.3, "end": 2369.46, "text": " is greater than", "tokens": [50458, 307, 5044, 813, 50516], "temperature": 0.0, "avg_logprob": -0.17691219016297222, "compression_ratio": 1.6418918918918919, "no_speech_prob": 2.1091346984886128e-12}, {"id": 815, "seek": 236644, "start": 2369.46, "end": 2370.78, "text": " or equal to 1,", "tokens": [50516, 420, 2681, 281, 502, 11, 50582], "temperature": 0.0, "avg_logprob": -0.17691219016297222, "compression_ratio": 1.6418918918918919, "no_speech_prob": 2.1091346984886128e-12}, {"id": 816, "seek": 236644, "start": 2371.34, "end": 2372.1, "text": " the probability", "tokens": [50610, 264, 8482, 50648], "temperature": 0.0, "avg_logprob": -0.17691219016297222, "compression_ratio": 1.6418918918918919, "no_speech_prob": 2.1091346984886128e-12}, {"id": 817, "seek": 236644, "start": 2372.1, "end": 2373.36, "text": " of that entire network", "tokens": [50648, 295, 300, 2302, 3209, 50711], "temperature": 0.0, "avg_logprob": -0.17691219016297222, "compression_ratio": 1.6418918918918919, "no_speech_prob": 2.1091346984886128e-12}, {"id": 818, "seek": 236644, "start": 2373.36, "end": 2374.92, "text": " working with real numbers", "tokens": [50711, 1364, 365, 957, 3547, 50789], "temperature": 0.0, "avg_logprob": -0.17691219016297222, "compression_ratio": 1.6418918918918919, "no_speech_prob": 2.1091346984886128e-12}, {"id